{
  "name": "robiai",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Robi Labs models API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/client.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robi-Labs/Typescript-SDK.git"
  },
  "homepage": "https://console.robiai.com/docs",
  "keywords": [
    "robi",
    "robiai",
    "sdk",
    "llm",
    "ai",
    "openai-compatible",
    "image-generation",
    "video-generation"
  ]
}
